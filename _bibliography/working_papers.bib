@unpublished{prakash2025research,
  abbr        = {URW 2025},
  bibtex_show = {true},
  title       = {Research on Research on Research: Analyzing historical trends in statistical and computational research from the 1990s to modern day},
  author      = {Prakash, Naren},
  year        = {2025},
  month       = mar,
  note        = {Undergraduate course paper, UCLA Department of Statistics and Data Science. Presented at UCLA Undergraduate Research Week 2025.},
  abstract    = {This paper aims to analyze the changes in research paper output for different statistical and computational fields over the time period from the 1990s to modern day (2025). The paper also projects short term growth for recently emerging fields in an effort to predict the fields that will receive further resource funding and attention in the near future. The research papers used for this analysis are sourced from a dataset of papers sourced from the pre-print journal arXiv.},
